{
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "users-auth": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/users/auth/{**catch-all}"
        }
      },
      "users-profile-picture": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/users/Users/{userId}/profile-picture"
        }
      },
      "users-protected": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "appointments-route": {
        "ClusterId": "appointments-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      },
      "care-route": {
        "ClusterId": "care-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/care/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://userservice:8080/"
          }
        }
      },
      "appointments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://appointmentservice:8080/"
          }
        }
      },
      "care-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://careservice:8080/"
          }
        }
      }
    }
  },
  "Jwt": {
    "Issuer": "CareBridge",
    "Audience": "CareBridge"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
